    "updated_at"
  ],
  "string_list_fields": [
    "matched_keywords",
    "match_reasons",
    "requirement_gaps",
    "selected_proof_refs"
  ],
  "json_array_fields": [
    "application_instructions",
    "screening_questions",
    "requirement_coverage",
    "application_message_plan",
    "application_warnings"
  ],
  "json_field_maximum_characters": {
    "application_instructions": 20000,
    "screening_questions": 12000,
    "requirement_coverage": 30000,
    "application_message_plan": 20000,
    "application_warnings": 12000
  },
  "timestamp_fields": [
    "posted_at",
    "discovered_at",
    "last_seen_at",
    "evaluated_at",
    "submission_started_at",
    "submission_confirmed_at",
    "review_decided_at",
    "review_approved_at",
    "processing_started_at",
    "next_retry_at",
    "generated_at",
    "application_pack_generated_at",
    "preparation_updated_at",
    "alert_last_attempt_at",
    "alert_next_retry_at",
    "alert_sent_at",
    "applied_at",
    "archived_at",
    "outcome_at",
    "created_at",
    "updated_at"
  ],
  "field_rules": {
    "record_version": {
      "type": "integer",
      "minimum": 1,
      "nullable": false
    },
    "pipeline_status": {
      "type": "enum",
      "values": [
        "new",
        "processing",
        "ready_to_apply",
        "review_needed",
        "skip",
        "error",
        "unavailable"
      ],
      "nullable": false
    },
    "user_action": {
      "type": "enum",
      "values": [
        "",
        "I Applied",
        "Skip",
        "Proceed",
        "Reject"
      ]
    },
    "required_input": {
      "type": "string",
      "maximum_length": 4000
    },
    "execution_mode": {
      "type": "enum",
      "values": [
        "legacy_manual",
        "autonomous_chrome"
      ],
      "nullable": false
    },
    "automation_contract_version": {
      "type": "enum",
      "values": [
        "",
        "browser-contract-v1"
      ]
    },
    "autonomous_decision": {
      "type": "enum",
      "values": [
        "",
        "apply",
        "skip"
      ]
    },
    "browser_state": {
      "type": "enum",
      "values": [
        "",
        "queued",
        "claimed",
        "evaluating",
        "generating",
        "filling",
        "submit_started",
        "confirmed",
        "retryable",
        "ambiguous",
        "blocked",
        "unavailable",
        "skipped"
      ]
    },
    "browser_attempt_id": {
      "type": "string",
      "maximum_length": 75,
      "pattern": "^(?:|attempt-v1:[a-f0-9]{64})$"
    },
    "browser_job_digest": {
      "type": "string",
      "maximum_length": 74,
      "pattern": "^(?:|job-v1:[a-f0-9]{64})$"
    },
    "browser_context_digest": {
      "type": "string",
      "maximum_length": 75,
      "pattern": "^(?:|context-v1:[a-f0-9]{64})$"
    },
    "browser_form_fingerprint": {
      "type": "string",
      "maximum_length": 75,
      "pattern": "^(?:|form-v1:[a-f0-9]{64})$"
    },
    "submission_idempotency_key": {
      "type": "string",
      "maximum_length": 81,
      "pattern": "^(?:|submission-v1:[a-f0-9]{64})$"
    },
    "submission_confirmation_kind": {
      "type": "enum",
      "values": [
        "",
        "confirmation_page",
        "application_history"
      ]
    },
    "submission_confirmation_reference": {
      "type": "string",
      "maximum_length": 86,
      "pattern": "^(?:|confirmation-ref-v1:[a-f0-9]{64})$"
    },
    "submission_confirmation_digest": {
      "type": "string",
      "maximum_length": 82,
      "pattern": "^(?:|confirmation-v1:[a-f0-9]{64})$"
    },
    "submission_attestation_key_id": {
      "type": "string",
      "maximum_length": 120,
      "pattern": "^(?:|[A-Za-z0-9][A-Za-z0-9._:-]{0,119})$"
    },
    "submission_attestation_witness_digest": {
      "type": "string",
      "maximum_length": 75,
      "pattern": "^(?:|witness-v1:[a-f0-9]{64})$"
    },
    "submission_attestation_signature": {
      "type": "string",
      "maximum_length": 120,
      "pattern": "^(?:|[A-Za-z0-9_-]{80,120})$"
    },
    "browser_block_category": {
      "type": "enum",
      "values": [
        "",
        "missing_candidate_fact",
        "login_required",
        "challenge",
        "captcha",
        "unexpected_agreement",
        "unsafe_upload",
        "unsupported_external_step",
        "invalid_form",
        "policy_mismatch",
        "unsafe_page_content",
        "posting_unavailable",
        "navigation_failed",
        "transient_browser_failure",
        "submission_uncertain",
        "submission_rejected",
        "confirmation_mismatch"
      ]
    },
    "review_case_id": {
      "type": "string",
      "maximum_length": 79,
      "pattern": "^(?:|review-case-v1:[a-f0-9]{64})$"
    },
    "review_case_version": {
      "type": "enum",
      "values": [
        "",
        "review-case-v1"
      ]
    },
    "review_decision": {
      "type": "enum",
      "values": [
        "",
        "proceed",
        "reject"
      ]
    },
    "review_approval_note": {
      "type": "string",
      "maximum_length": 1000
    },
    "review_approval_guard": {
      "type": "string",
      "maximum_length": 80,
      "pattern": "^(?:|review-v1:[a-f0-9]{64})$"
    },
    "source_availability": {
      "type": "enum",
      "values": [
        "",
        "active",
        "unavailable"
      ]
    },
    "qualification_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "nullable": true
    },
    "opportunity_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "nullable": true
    },
    "ranking_confidence": {
      "type": "enum",
      "values": [
        "",
        "high",
        "medium",
        "low"
      ]
    },
    "attempt_count": {
      "type": "integer",
      "minimum": 0,
      "nullable": false
    },
    "message_validation_status": {
      "type": "enum",
      "values": [
        "",
        "valid",
        "quarantined"
      ]
    },
    "application_pack_status": {
      "type": "enum",
      "values": [
        "",
        "ready",
        "review_required",
        "blocked"
      ]
    },
    "prep_status": {
      "type": "enum",
      "values": [
        "",
        "pending",
        "preparing",
        "message_ready",
        "needs_input",
        "external_steps",
        "repair_pending",
        "preparation_error"
      ]
    },
    "preparation_version": {
      "type": "integer",
      "minimum": 0,
      "nullable": false
    },
    "preparation_input_guard": {
      "type": "string",
      "maximum_length": 72,
      "pattern": "^(?:|prep-v1:[a-f0-9]{64})$"
    },
    "alert_status": {
      "type": "enum",
      "values": [
        "",
        "pending",
        "sending",
        "sent",
        "retryable_failure",
        "terminal_failure",
        "suppressed"
      ]
    },
    "alert_claim_token": {
      "type": "string",
      "maximum_length": 256
    },
    "outcome": {
      "type": "enum",
      "values": [
        "",
        "no_response",
        "replied",
        "interview",
        "offer",
        "rejected"
      ]
    },
    "outcome_recorded_value": {
      "type": "enum",
      "values": [
        "",
        "no_response",
        "replied",
        "interview",
        "offer",
        "rejected"
      ]
    },
    "notes": {
      "type": "string",
      "maximum_length": 1000
    }
  },
  "business_results": [
    "ready_to_apply",
    "review_needed",
    "skip"
  ],
  "operational_conditions": [
    "new",
