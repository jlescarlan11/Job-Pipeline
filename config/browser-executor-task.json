  },
  "project": {
    "mode": "local_project_root",
    "required_root_markers": [
      "AGENTS.md",
      "package.json"
    ]
  },
  "workbooks": {
    "queue_environment_variable": "JOB_PIPELINE_SPREADSHEET_ID",
    "configuration_environment_variable": "JOB_PIPELINE_CONFIG_SPREADSHEET_ID"
  },
  "privacy": {
    "log_generated_message": false,
