{
  "schema_version": 1,
  "contract_version": "2026-08-10/browser-task-v1",
  "role": "browser_executor",
  "surface": "codex_scheduled_task",
  "source_control_state": "inactive_unscheduled",
  "prompt": {
    "version": "2026-08-10/browser-task-prompt-v1",
    "path": "docs/browser-executor-task-prompt.md"
  },
  "skill": {
    "name": "job-autopilot",
    "version": "job-autopilot-v1",
    "path": ".agents/skills/job-autopilot/SKILL.md",
    "explicit_invocation_required": true
  },
  "browser_plugin": {
    "name": "Chrome",
    "uri": "plugin://chrome@openai-bundled",
    "browser_family": "chrome",
    "explicit_invocation_required": true,
    "signed_in_profile_required": true,
    "history_access_required": false,
    "allowed_hosts": [
      "onlinejobs.ph",
      "www.onlinejobs.ph"
    ]
  },
  "confirmation_attestation": {
    "required": true,
    "source": "independent_application_history_adapter",
    "algorithm": "ed25519",
    "public_key_environment_variable": "JOB_PIPELINE_BROWSER_ATTESTATION_PUBLIC_KEY",
    "key_id": "unprovisioned",
    "public_key_spki_sha256": "unprovisioned",
    "private_key_available_to_task": false
  },
  "click_consumption": {
    "receipt_store": "private_pinned_dual_anchor_hash_chain",
    "directory_environment_variable": "JOB_PIPELINE_BROWSER_CLICK_RECEIPT_DIR",
    "witness_file_environment_variable": "JOB_PIPELINE_BROWSER_CLICK_WITNESS_FILE",
    "store_id": "unprovisioned",
    "ledger_id": "unprovisioned",
    "generation_id": "unprovisioned",
    "manifest_sha256": "unprovisioned",
    "directory_binding_digest": "unprovisioned",
    "directory_identity": "unprovisioned",
    "witness_identity": "unprovisioned",
    "receipt_schema_version": 1,
    "durability": "private_pinned_fs_identity_hash_chain_witness_fsync_before_capability",
    "existing_receipt_behavior": "reconcile_without_click",
    "loss_or_restore_behavior": "disable_reconcile_rotate_never_restore_witness"
  },
  "executor": {
    "protocol_version": "2026-08-10/v1",
    "module_path": "src/browser-executor.mjs",
    "cli_path": "scripts/browser-executor.mjs",
    "allowed_operations": [
      "select",
      "plan-claim",
      "confirm-claim",
      "validate-decision",
      "confirm-browser-ready",
      "plan-submit-intent",
      "confirm-submit-intent",
      "commit-result",
      "reconcile-result",
      "recover"
    ],
    "generic_sheet_write_allowed": false,
    "business_row_relocation_allowed": false
  },
  "runtime": {
    "timezone": "Asia/Manila",
    "schedule_minutes": 90,
    "schedule_offset_minutes": 2,
    "execution_timeout_seconds": 480,
    "claim_lease_ms": 600000,
    "minimum_attempt_headroom_ms": 120000,
    "continuation_mode": "technical_headroom_next_schedule",
    "retry": {
      "max_attempts": 3,
      "backoff_ms": 300000
    }
  },
