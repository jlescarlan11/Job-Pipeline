    "signed_in_profile_required": true,
    "history_access_required": false,
    "allowed_hosts": [
      "onlinejobs.ph",
      "www.onlinejobs.ph"
    ]
  },
  "confirmation_attestation": {
    "required": true,
    "source": "independent_application_history_adapter",
    "algorithm": "ed25519",
    "public_key_environment_variable": "JOB_PIPELINE_BROWSER_ATTESTATION_PUBLIC_KEY",
    "key_id": "unprovisioned",
    "public_key_spki_sha256": "unprovisioned",
    "private_key_available_to_task": false
  },
  "click_consumption": {
    "receipt_store": "private_pinned_dual_anchor_hash_chain",
