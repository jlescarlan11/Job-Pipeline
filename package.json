{
  "name": "job-pipeline",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:workflows && npm run build:sheet-setup",
    "build:workflows": "node scripts/build-workflows.mjs",
    "build:sheet-setup": "node scripts/build-sheet-setup.mjs",
    "check:artifacts": "npm run check:workflows && node scripts/build-sheet-setup.mjs --check",
    "check:workflows": "node scripts/build-workflows.mjs --check",
    "test": "node --test",
    "validate": "npm run check:artifacts && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
