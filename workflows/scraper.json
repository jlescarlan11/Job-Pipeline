    {
      "parameters": {
        "jsCode": "// Get Sheet1 rows from the new Aggregate node\nconst sheet1Aggregate = $('Aggregate Sheet1').first().json;\nconst sheet1Rows = sheet1Aggregate.sheet1_rows || [];\n\n// Get Archive rows (current input — should be a small number of items)\nconst archiveRows = $input.all();\n\n// Build a combined Set of URLs from both sheets\nconst existingUrls = new Set([\n  ...sheet1Rows.map(row => row.job_url).filter(url => url),\n  ...archiveRows.map(row => row.json.job_url).filter(url => url),\n]);\n\n// Get the scraped jobs from the first Aggregate (named \"Aggregate\")\nconst aggregateOutput = $('Aggregate').first().json;\nconst scrapedJobs = aggregateOutput.scraped_jobs || [];\n\n// Filter: keep only jobs whose URL is NOT in either sheet\nconst newJobs = scrapedJobs.filter(job => !existingUrls.has(job.job_url));\n\n// Dedupe within scraped batch\nconst seenInBatch = new Set();\nconst uniqueNewJobs = newJobs.filter(job => {\n  if (seenInBatch.has(job.job_url)) return false;\n  seenInBatch.add(job.job_url);\n  return true;\n});\n\nreturn uniqueNewJobs.map(job => ({ json: job }));"
      },
