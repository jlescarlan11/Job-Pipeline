    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst result = [];\n\n// Calculate cutoff date: 7 days ago from now\nconst cutoffDate = new Date();\ncutoffDate.setDate(cutoffDate.getDate() - 7);\n\nfor (const item of allItems) {\n  const html = item.json.data || '';\n  if (!html) continue;\n  \n  // Each job card is wrapped in: <a href=\"/jobseekers/job/...\"> ... <div class=\"jobpost-cat-box\"> ... </div> ... </a>\n  // We capture the URL and the inner content of the card together, guaranteed aligned.\n  const cardRegex = /<a\\s+href=\"(\\/jobseekers\\/job\\/[^\"]+)\"[^>]*>\\s*<div[^>]*class=\"[^\"]*jobpost-cat-box[^\"]*\"[^>]*>([\\s\\S]*?)<\\/div>\\s*<\\/a>/g;\n  \n  let match;\n  while ((match = cardRegex.exec(html)) !== null) {\n    const urlPath = match[1];\n    const cardHtml = match[2];\n    \n    // Skip URLs that are just numeric IDs (See More links — shouldn't happen with this selector, but defensive)\n    const slug = urlPath.replace('/jobseekers/job/', '');\n    if (/^\\d+$/.test(slug)) continue;\n    \n    // Extract title from <h4 class=\"...\"> ... </h4>, strip the badge span first\n    const h4Match = cardHtml.match(/<h4[^>]*>([\\s\\S]*?)<\\/h4>/);\n    if (!h4Match) continue;\n    let titleHtml = h4Match[1];\n    // Remove the type badge (Full Time / Part Time / etc.)\n    titleHtml = titleHtml.replace(/<span[^>]*class=\"[^\"]*badge[^\"]*\"[^>]*>[\\s\\S]*?<\\/span>/g, '');\n    // Strip remaining HTML tags\nlet title = titleHtml.replace(/<[^>]+>/g, '').trim().replace(/\\s+/g, ' ');\n// Decode common HTML entities\ntitle = title\n  .replace(/&#039;/g, \"'\")\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&nbsp;/g, ' ');\n    \n    // Extract posted date from <p data-temp=\"...\"> <em>Posted on YYYY-MM-DD HH:MM:SS</em> </p>\n    const dateMatch = cardHtml.match(/<em>\\s*Posted on\\s+([0-9\\-\\s:]+)<\\/em>/);\n    if (!dateMatch) continue;\n    const postedDate = dateMatch[1].trim();\n    \n    // Extract salary from <dd class=\"col\">...</dd> within the salary block\n    let salary = '';\n    const salaryMatch = cardHtml.match(/<dd class=\"col\">([\\s\\S]*?)<\\/dd>/);\n    if (salaryMatch) {\nsalary = salaryMatch[1].replace(/<[^>]+>/g, '').trim()\n  .replace(/&#039;/g, \"'\")\n  .replace(/&amp;/g, '&')\n  .replace(/&quot;/g, '\"')\n  .replace(/&nbsp;/g, ' ');\n    }\n    \n    // Parse date and apply 7-day filter\n    const dt = new Date(postedDate);\n    if (isNaN(dt.getTime())) continue;\n    if (dt < cutoffDate) continue;\n    \n    result.push({\n      json: {\n        job_url: 'https://www.onlinejobs.ph' + urlPath,\n        job_title: title,\n        posted_date: postedDate,\n        salary: salary,\n      }\n    });\n  }\n}\n\nreturn result;"
      },
