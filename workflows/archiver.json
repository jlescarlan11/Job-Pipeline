    {
      "parameters": {
        "jsCode": "// Get all rows from Sheet1\nconst allRows = $input.all();\n\n// Filter to rows that should be archived (status = applied, skipped, or error)\nconst archivableStatuses = ['applied', 'skipped', 'error'];\n\nconst rowsToArchive = allRows.filter(row => {\n  const status = (row.json.status || '').toLowerCase().trim();\n  return archivableStatuses.includes(status);\n});\n\nif (rowsToArchive.length === 0) {\n  console.log('No rows to archive this run.');\n  return [];\n}\n\nconsole.log(`Found ${rowsToArchive.length} rows to archive.`);\n\n// Sort by row_number DESCENDING — important!\n// We delete from bottom up so row indices don't shift mid-delete\nrowsToArchive.sort((a, b) => (b.json.row_number || 0) - (a.json.row_number || 0));\n\n// Build output items with all fields explicit\nreturn rowsToArchive.map(row => ({\n  json: {\n    row_number: row.json.row_number,\n    job_title: row.json.job_title || '',\n    company: row.json.company || '',\n    job_url: row.json.job_url || '',\n    job_description: row.json.job_description || '',\n    status: row.json.status || '',\n    generated_message: row.json.generated_message || '',\n    created_at: row.json.created_at || '',\n    notes: row.json.notes || '',\n    archived_at: new Date().toISOString(),\n  }\n}));"
      },
